# Copy this file to .env and fill in real values.
# The app runs perfectly fine with NONE of these set — it falls back to mock
# product data and the WhatsApp button just won't have a number yet.

# ── WhatsApp (simplest possible integration: wa.me deep links) ──────────────
# Your WhatsApp number in international format, DIGITS ONLY.
# No +, no spaces, no dashes, no leading 0 on the local number.
# Lebanon (+961): drop the leading 0 from your local number, then prefix 961.
#   Local 03 123 456   → 9613123456
#   Local 70 123 456   → 96170123456
#   Local 81 123 456   → 96181123456
VITE_WHATSAPP_NUMBER=

# ── Supabase (optional — leave blank to use bundled mock catalog) ──────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Store settings ──────────────────────────────────────────────────────────
VITE_CURRENCY=USD
VITE_LOCALE=en-US
VITE_DELIVERY_FEE=5
VITE_FREE_DELIVERY_OVER=150
